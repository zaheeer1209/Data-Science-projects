        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "# Step 1: Reading the file\n",
        "# Assuming the file is named 'toyota_corolla.csv' and is in the same directory as this script\n",
        "df = pd.read_excel('/content/ToyotaCorolla.xlsx')\n",
        "# Step 2: Exploratory Data Analysis\n",
        "print(\"First few rows of the dataset:\")\n",
        "print(df.head())\n",
        "print(\"\\nDataset information:\")\n",
        "print(df.info())\n",
        "print(\"\\nSummary statistics:\")\n",
        "print(df.describe())\n",
        "# Check for missing values\n",
        "print(\"\\nMissing values:\")\n",
        "print(df.isnull().sum())\n",
        "# Visualize the distribution of prices\n",
        "plt.figure(figsize=(10, 6))\n",
        "sns.histplot(df['Price'], kde=True)\n",
        "plt.title('Distribution of Toyota Corolla Prices')\n",
        "plt.xlabel('Price')\n",
        "plt.ylabel('Count')\n",
        "plt.savefig('price_distribution.png')\n",
        "plt.close()\n",
        "# Correlation matrix\n",
        "correlation_matrix = df.select_dtypes(include=['float64', 'int64']).corr()\n",
        "plt.figure(figsize=(12, 10))\n",
        "sns.heatmap(correlation_matrix, annot=True, cmap='coolwarm', linewidths=0.5)\n",
        "plt.title('Correlation Matrix of Numerical Features')\n",
        "plt.savefig('correlation_matrix.png')\n",
        "plt.close()\n",
        "# Step 3: Data Preparation and Pre-processing\n",
        "# Handle missing values (if any)\n",
        "df = df.dropna()\n",
        "# Convert categorical variables to numerical (example with 'Fuel_Type')\n",
        "df = pd.get_dummies(df, columns=['Fuel_Type'], drop_first=True)\n",
        "# Normalize numerical features\n",
        "from sklearn.preprocessing import MinMaxScaler\n",
        "scaler = MinMaxScaler()\n",
        "numerical_features = ['Age_08_04', 'KM', 'HP', 'Quarterly_Tax', 'Weight']\n",
        "df[numerical_features] = scaler.fit_transform(df[numerical_features])\n",
        "print(\"\\nFirst few rows after pre-processing:\")\n",
        "print(df.head())\n",
        "# Save the preprocessed dataset\n",
        "df.to_excel('toyota_corolla_preprocessed.xlsx', index=False)\n",
        "print(\"\\nPre-processing complete. Preprocessed dataset saved as'toyota_corolla_preprocessed.xlsx'\")"
